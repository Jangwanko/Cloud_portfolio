# Application
APP_NAME=Reliable Event Processing API
APP_ENV=local
APP_PORT=8000
REQUEST_BODY_MAX_BYTES=1048576
AUTH_SECRET_KEY=replace-with-a-random-local-secret
ACCESS_TOKEN_TTL_SECONDS=3600
PASSWORD_HASH_ITERATIONS=600000
DEMO_RESET_ENABLED=true
GENERIC_EVENTS_V2_ENABLED=true

# PostgreSQL / Pgpool
# DATABASE_URL is optional. When omitted, the DB_* values below are used.
# DATABASE_URL=postgresql://portfolio:replace-me@localhost:5432/portfolio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=replace-me
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=20
DB_CONNECT_TIMEOUT=3
POSTGRES_MIN_READY_STANDBYS=2
POSTGRES_MIN_SYNC_STANDBYS=1
POSTGRES_REPLICATION_DELAY_DEGRADED_BYTES=1048576

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PARTITIONS=8
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_INGRESS_TOPIC=message-ingress
KAFKA_DLQ_TOPIC=message-ingress-dlq
KAFKA_REQUEST_STATUS_TOPIC=message-request-status
KAFKA_MESSAGE_SNAPSHOT_TOPIC=message-snapshots
KAFKA_STREAM_SNAPSHOT_TOPIC=stream-snapshots
KAFKA_NOTIFICATION_TOPIC=message-notifications
KAFKA_CONSUMER_GROUP=message-worker
KAFKA_NOTIFICATION_CONSUMER_GROUP=notification-worker

# Retry / replay
INGRESS_MAX_RETRIES=3
INGRESS_RETRY_BASE_DELAY_SECONDS=2
DLQ_REPLAY_ENABLED=true
DLQ_REPLAY_INTERVAL_SECONDS=0.2
DLQ_REPLAY_BATCH_SIZE=5
DLQ_REPLAY_MAX_COUNT=3

# Startup / readiness / materialized cache
STARTUP_RETRIES=30
STARTUP_RETRY_DELAY=2
READINESS_DEGRADED_GRACE_SECONDS=30
SNAPSHOT_CACHE_FRESH_SECONDS=5
MATERIALIZED_CACHE_MAX_REQUEST_STATUSES=20000
MATERIALIZED_CACHE_MAX_MESSAGES=20000
MATERIALIZED_CACHE_MAX_STREAMS=5000

# Metrics and Kubernetes metadata
WORKER_METRICS_PORT=9101
DLQ_REPLAYER_METRICS_PORT=9102
PROMETHEUS_BASE_URL=http://localhost/prometheus
K8S_NAMESPACE=messaging-app
WORKER_DEPLOYMENT_NAME=worker
WORKER_HPA_NAME=worker-keda-hpa
WORKER_MODE=ingress
